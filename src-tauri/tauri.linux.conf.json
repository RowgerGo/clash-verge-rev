{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "bundle": {
    "targets": ["deb", "rpm"],
    "linux": {
      "deb": {
        "depends": ["openssl", "libayatana-appindicator3-1"],
        "desktopTemplate": "./packages/linux/dayup-link.desktop",
        "postInstallScript": "./packages/linux/post-install.sh",
        "preRemoveScript": "./packages/linux/pre-remove.sh"
      },
      "rpm": {
        "depends": ["openssl", "libayatana-appindicator-gtk3"],
        "recommends": ["policycoreutils", "policycoreutils-python-utils"],
        "desktopTemplate": "./packages/linux/dayup-link.desktop",
        "postInstallScript": "./packages/linux/post-install-rpm.sh",
        "preRemoveScript": "./packages/linux/pre-remove.sh"
      }
    },
    "externalBin": [
      "sidecar/dayup-link-service",
      "sidecar/dayup-link-service-install",
      "sidecar/dayup-link-service-uninstall",
      "sidecar/dayup-mihomo",
      "sidecar/dayup-mihomo-alpha"
    ]
  }
}
